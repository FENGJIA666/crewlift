# Configure locally. Never paste a real key in chat or commit it.
NEBIUS_API_KEY=
PORT=4187

# Public deployment only. Root configures secrets in the hosting dashboard.
CREWLIFT_PUBLIC_ORIGIN=
CREWLIFT_SESSION_SECRET=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
CREWLIFT_STORE_NAMESPACE=crewlift-production
# Public inference is disabled until an explicit allocation and ledger exist.
CREWLIFT_LIVE_REQUEST_LIMIT=0
